# ─────────────────────────────────────────────────────────────────────────────
#  Watcher — variables d'environnement
#  Copier ce fichier en `.env` (local) ou renseigner ces variables dans Coolify.
#  Ne JAMAIS committer de vraies clés.
# ─────────────────────────────────────────────────────────────────────────────

# URL publique de l'application (sans slash final). Utilisée dans les emails et redirections Stripe.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Watcher

# Secret applicatif (≥ 32 caractères aléatoires) : pseudonymisation des adresses IP dans les journaux.
# Générer avec :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=change-me-dev-only-secret-at-least-32-characters-long

# Derrière le reverse proxy de Coolify (Traefik/Caddy), l'IP réelle est dans X-Forwarded-For.
TRUST_PROXY=true

# ─── Base de données PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql://watcher:watcher@localhost:5432/watcher?schema=public

# ─── Stockage des fichiers (photos, justificatifs) ───────────────────────────
# "local" : disque (monter un volume persistant sur STORAGE_LOCAL_DIR en production)
# "s3"    : tout stockage compatible S3 (MinIO, Scaleway, OVH, AWS, Cloudflare R2…)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Si STORAGE_DRIVER=s3 — le bucket DOIT être privé (aucun accès public).
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=watcher-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Sans SMTP_HOST, les emails sont affichés dans les logs du serveur (développement).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Watcher <no-reply@example.com>"
# Destinataire des notifications internes (nouveau pro à valider, signalement de possession…)
ADMIN_NOTIFICATION_EMAIL=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Dashboard Stripe > Développeurs > Clés API (sk_test_… en test, sk_live_… en production)
STRIPE_SECRET_KEY=
# Dashboard Stripe > Développeurs > Webhooks > endpoint https://VOTRE-DOMAINE/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# IDs de prix (price_…) utilisés UNIQUEMENT par le seed pour pré-remplir les offres.
# Les offres restent ensuite éditables depuis /admin/abonnements.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ─── Tâches planifiées ───────────────────────────────────────────────────────
# Protège POST /api/cron/maintenance (purge des données expirées). Chaîne aléatoire longue.
CRON_SECRET=

# ─── Démarrage du conteneur ──────────────────────────────────────────────────
# Crée un administrateur au démarrage s'il n'en existe aucun (à retirer ensuite).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Charge les données de démonstration (JAMAIS en production réelle).
SEED_DEMO_DATA=false
